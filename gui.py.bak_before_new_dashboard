    def _uniqa_loaded(
        self,
        uniqa,
        when,
    ):

        if uniqa.available:

            duplicates = len(
                getattr(
                    uniqa,
                    "duplicates",
                    [],
                )
            )

            self.uniqa_dot.config(
                fg=GREEN_FG,
            )

            self.uniqa_status.config(
                text=f"Načteno: {when}",
                fg=GREEN_FG,
            )

            self.uniqa_detail.config(
                text=(
                    f"Aktivních VIN: {len(uniqa.vehicles)}"
                    f" • Duplicitních VIN: {duplicates}"
                )
            )

        else:

            self.uniqa_dot.config(
                fg=RED_FG,
            )

            self.uniqa_status.config(
                text="Načtení selhalo",
                fg=RED_FG,
            )


