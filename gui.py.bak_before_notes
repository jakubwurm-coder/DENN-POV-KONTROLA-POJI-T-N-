    def workflow_for(
        self,
        vin: str,
        issue_status: str,
    ) -> str:

        row = self.case_for(
            vin,
            issue_status,
        )

        if row:
            return row["workflow_status"]

        if issue_status == "OK":
            return ""

        return "K ŘEŠENÍ"

    def note_for(
        self,
        vin: str,
        issue_status: str,
    ) -> str:

        row = self.case_for(
            vin,
            issue_status,
        )

        if not row:
            return ""

        return row["note"] or ""


