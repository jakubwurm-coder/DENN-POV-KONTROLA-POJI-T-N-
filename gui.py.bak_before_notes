            fg=TEXT_MUTED,
        )

        threading.Thread(
            target=self._run_check_thread,
            daemon=True,
        ).start()


    # ========================================================
    # BACKGROUND
    # ========================================================

    def _run_check_thread(self):

        try:

            config = load_config()

            tir, duplicates = load_tirbazar_vehicles(
                config
            )

            self.tir_vehicles = tir

            self.active_count = sum(
                1
                for vehicle in tir
                if not vehicle.datum_prodeje
            )

            self.tirbazar_loaded_at = datetime.now().strftime(
                "%d.%m.%Y %H:%M:%S"
            )

            self.after(
                0,
                self._tir_loaded,
            )

            self.after(
                0,
                self._uniqa_loading,
            )

            uniqa = load_uniqa_vehicles()

            self.uniqa_loaded_at = datetime.now().strftime(
                "%d.%m.%Y %H:%M:%S"
            )

            self.uniqa_duplicates = getattr(
                uniqa,
                "duplicates",
                [],
            )

            self.uniqa_raw_count = getattr(
                uniqa,
                "raw_count",
                len(uniqa.vehicles),
            )

            self.uniqa_unique_count = len(
                uniqa.vehicles
            )

            results = compare_vehicles(
                tir=tir,
                uniqa=uniqa.vehicles,
                uniqa_available=uniqa.available,
                uniqa_error=uniqa.error,
            )

            base = prepare_output()

            try:
                write_tirbazar_snapshot(
                    tir,
                    base,
                )
            except TypeError:
                active = [
                    v for v in tir
                    if not v.datum_prodeje
                ]

                sold = [
                    v for v in tir
                    if v.datum_prodeje
                ]

                write_tirbazar_snapshot(
                    active,
                    sold,
                    base,
                )

            write_duplicates(
                duplicates,
                base,
            )

            self.last_csv = write_comparison(
                results,
                base,
            )

            self.results = results

            self.after(
                0,
                self._finish_check,
                uniqa,
            )

        except Exception as exc:

            self.after(
                0,
                self._show_error,
                str(exc),
            )


    # ========================================================
    # ZDROJE
    # ========================================================

    def _tir_loaded(self):

        self.tir_source_status.config(
            text=(
                f"TIRBAZAR DB • Načteno "
                f"{self.tirbazar_loaded_at}"
            ),
            fg=GREEN_FG,
        )

        self.tir_source_detail.config(
            text=(
                f"Aktivních ke kontrole: "
                f"{self.active_count}"
            )
        )

    def _uniqa_loading(self):

        self.uniqa_source_status.config(
            text="UNIQA PORTÁL • Načítám...",
            fg=ORANGE_FG,
        )

    def _finish_check(self, uniqa):

        if uniqa.available:

            self.live_status.config(
                text="UNIQA LIVE ✓",
                fg=GREEN_FG,
            )

            duplicate_groups = len(
                self.uniqa_duplicates
            )

            extra = max(
                0,
                self.uniqa_raw_count
                - self.uniqa_unique_count,
            )

            self.uniqa_source_status.config(
                text=(
                    f"UNIQA PORTÁL • Načteno "
                    f"{self.uniqa_loaded_at}"
                ),
                fg=GREEN_FG,
            )

            self.uniqa_source_detail.config(
                text=(
                    f"{self.uniqa_unique_count} unikátních VIN • "
                    f"{self.uniqa_raw_count} záznamů • "
                    f"{duplicate_groups} duplicitních VIN • "
                    f"{extra} záznamů navíc"
                )
            )

        else:

            self.live_status.config(
                text="UNIQA NEDOSTUPNÁ",
                fg=RED_FG,
            )

        self.update_cards()
        self.fill_table()

        self.run_button.config(
            state="normal",
            text="▶  SPUSTIT KONTROLU",
        )

        self.footer_left.config(
            text=(
                "Kontrola dokončena: "
                + datetime.now().strftime(
                    "%d.%m.%Y %H:%M:%S"
                )
            )
        )


    # ========================================================
    # KARTY
    # ========================================================

    def update_cards(self):

        counts = Counter()

        for result in self.results:

            workflow = self.workflow_for(
                result.vin,
                result.status,
            )

            if workflow == "VYŘEŠENO":
                continue

            counts[result.status] += 1

        self.cards["ACTIVE"].config(
            text=str(
                self.active_count
            )
        )

        for status in (
            "OK",
            "CHYBÍ V UNIQA",
            "PRODANÉ, ALE V UNIQA",
            "SPZ NESOUHLASÍ",
            "NAVÍC V UNIQA",
        ):
            self.cards[status].config(
                text=str(
                    counts.get(
                        status,
                        0,
                    )
                )
            )

        unresolved_duplicate_vins = 0

        for group in self.uniqa_duplicates:

            if not group:
                continue

            vin = group[0].vin

            if self.workflow_for(
                vin,
                "DUPLICITNÍ V UNIQA",
            ) != "VYŘEŠENO":
                unresolved_duplicate_vins += 1

        self.cards[
            "DUPLICITNÍ V UNIQA"
        ].config(
            text=str(
                unresolved_duplicate_vins
            )
        )

        self._update_resolved_card()

    def _update_resolved_card(self):

        self.cards["VYŘEŠENO"].config(
            text=str(
                self.case_store.count_resolved()
            )
        )


    # ========================================================
    # TABULKA
    # ========================================================

    def fill_table(self):

        for item in self.tree.get_children():
            self.tree.delete(item)

        search = (
            self.search_var.get()
            .strip()
            .upper()
        )

        selected_filter = self.filter_var.get()

        shown = 0


        # ====================================================
        # VYŘEŠENO
        # ====================================================

        if selected_filter == "VYŘEŠENO":

            for row in self.case_store.resolved():

                searchable = " ".join(
                    [
                        row["vin"],
                        row["issue_status"],
                        row["note"],
                        row["tir_spz"],
                        row["uniqa_spz"],
                        row["detail"],
                    ]
                ).upper()

                if search and search not in searchable:
                    continue

                self.tree.insert(
                    "",
                    "end",
                    values=(
                        row["issue_status"],
                        "VYŘEŠENO",
                        row["vin"],
                        row["tir_spz"],
                        row["uniqa_spz"],
                        row["note"],
                        row["detail"],
                    ),
                    tags=(
                        row["issue_status"],
                    ),
                )

                shown += 1

            self.footer_right.config(
                text=f"Vyřešených případů: {shown}"
            )

            return


        # ====================================================
        # DUPLICITNÍ UNIQA
        # ====================================================

        if selected_filter == "DUPLICITNÍ V UNIQA":

            for group in self.uniqa_duplicates:

                if not group:
                    continue

                vin = group[0].vin

                workflow = self.workflow_for(
                    vin,
                    "DUPLICITNÍ V UNIQA",
                )

                if workflow == "VYŘEŠENO":
                    continue

                note = self.note_for(
                    vin,
                    "DUPLICITNÍ V UNIQA",
                )

                searchable = " ".join(
                    [
                        vin,
                        note,
                    ]
                    + [
                        v.spz or ""
                        for v in group
                    ]
                    + [
                        v.cps or ""
                        for v in group
                    ]
                ).upper()

                if search and search not in searchable:
                    continue

                detail = (
                    f"{len(group)} aktivních pojistných záznamů: "
                    + " | ".join(
                        [
                            (
                                f"ČPS {v.cps or '-'}, "
                                f"SPZ {v.spz or '-'}, "
                                f"od {v.poj_od or '-'}"
                            )
                            for v in group
                        ]
                    )
                )

                self.tree.insert(
                    "",
                    "end",
                    values=(
                        "DUPLICITNÍ V UNIQA",
                        workflow,
                        vin,
                        "",
                        group[0].spz or "",
                        note,
                        detail,
                    ),
                    tags=(
                        "DUPLICITNÍ V UNIQA",
                    ),
                )

                shown += 1

            self.footer_right.config(
                text=f"Duplicitních VIN: {shown}"
            )

            return


        # ====================================================
        # BĚŽNÉ VÝSLEDKY
        # ====================================================

        for result in self.results:

            workflow = self.workflow_for(
                result.vin,
                result.status,
            )

            # vyřešené už jsou v samostatné kartě
            if workflow == "VYŘEŠENO":
                continue

            if selected_filter == "ACTIVE":

                if result.status not in (
                    "OK",
                    "CHYBÍ V UNIQA",
                    "SPZ NESOUHLASÍ",
                    "NELZE OVĚŘIT",
                ):
                    continue

            elif selected_filter != "Vše":

                if result.status != selected_filter:
                    continue

            note = self.note_for(
                result.vin,
                result.status,
            )

            searchable = " ".join(
                [
                    result.status or "",
                    workflow,
                    result.vin or "",
                    result.tir_spz or "",
                    result.uniqa_spz or "",
                    note,
                    result.detail or "",
                ]
            ).upper()

            if search and search not in searchable:
                continue

            self.tree.insert(
                "",
                "end",
                values=(
                    result.status,
                    workflow,
                    result.vin,
                    result.tir_spz or "",
                    result.uniqa_spz or "",
                    note,
                    result.detail,
                ),
                tags=(
                    result.status,
                ),
            )

            shown += 1

        self.footer_right.config(
            text=f"Zobrazeno: {shown}"
        )


    # ========================================================
    # SELECT
    # ========================================================

    def on_select(self, _event=None):

        selected = self.tree.selection()

        if not selected:
            return

        values = self.tree.item(
            selected[0]
        ).get(
            "values",
            [],
        )

        if len(values) < 7:
            return

        (
            issue_status,
            workflow,
            vin,
            tir_spz,
            uniqa_spz,
            note,
            detail,
        ) = values

        self.selected_case = {
            "vin": str(vin),
            "issue_status": str(issue_status),
            "tir_spz": str(tir_spz),
            "uniqa_spz": str(uniqa_spz),
            "detail": str(detail),
        }

        self.editor_title.config(
            text=(
                f"{vin}  •  {issue_status}"
            )
        )

        self.workflow_var.set(
            workflow
            if workflow in WORKFLOW_STATUSES
            else "K ŘEŠENÍ"
        )

        self.note_text.delete(
            "1.0",
            "end",
        )

        self.note_text.insert(
            "1.0",
            note or "",
        )


    # ========================================================
    # ULOŽIT
    # ========================================================

    def save_case(self):

        if not self.selected_case:

            messagebox.showinfo(
                "UNIQA CHECKER",
                "Nejdřív vyber vozidlo v tabulce.",
            )

            return

        vin = self.selected_case["vin"]
        issue_status = self.selected_case[
            "issue_status"
        ]

        note = self.note_text.get(
            "1.0",
            "end",
        ).strip()

        workflow = self.workflow_var.get()

        self.case_store.save(
            vin=vin,
            issue_status=issue_status,
            workflow_status=workflow,
            note=note,
            tir_spz=self.selected_case["tir_spz"],
            uniqa_spz=self.selected_case["uniqa_spz"],
            detail=self.selected_case["detail"],
        )

        self.update_cards()
        self.fill_table()

        self.footer_left.config(
            text=(
                f"Poznámka uložena: {vin} • "
                f"{datetime.now().strftime('%H:%M:%S')}"
            )
        )


    # ========================================================
    # VYŘEŠENO
    # ========================================================

    def mark_resolved(self):

        if not self.selected_case:

            messagebox.showinfo(
                "UNIQA CHECKER",
                "Nejdřív vyber vozidlo.",
            )

            return

        self.workflow_var.set(
            "VYŘEŠENO"
        )

        self.save_case()


    # ========================================================
    # ERROR
    # ========================================================

    def _show_error(self, text):

        self.run_button.config(
            state="normal",
            text="▶  SPUSTIT KONTROLU",
        )

        self.live_status.config(
            text="CHYBA",
            fg=RED_FG,
        )

        messagebox.showerror(
            "UNIQA CHECKER",
            text,
        )


    # ========================================================
    # CSV
    # ========================================================

    def open_csv(self):

        if not self.last_csv:

            messagebox.showinfo(
                "UNIQA CHECKER",
                "Nejdřív spusť kontrolu.",
            )

            return

        subprocess.run(
            [
                "open",
                str(self.last_csv),
            ]
        )


