class CaseStore:

    def __init__(self, path: Path):
        self.path = path
        self._init_db()

    def connect(self):
        connection = sqlite3.connect(self.path)
        connection.row_factory = sqlite3.Row
        return connection

    def _init_db(self):
        with self.connect() as db:
            db.execute(
                """
                CREATE TABLE IF NOT EXISTS cases (
                    vin TEXT NOT NULL,
                    issue_status TEXT NOT NULL,

                    workflow_status TEXT NOT NULL DEFAULT 'K ŘEŠENÍ',
                    note TEXT NOT NULL DEFAULT '',

                    tir_spz TEXT NOT NULL DEFAULT '',
                    uniqa_spz TEXT NOT NULL DEFAULT '',
                    detail TEXT NOT NULL DEFAULT '',

                    created_at TEXT NOT NULL,
                    updated_at TEXT NOT NULL,

                    PRIMARY KEY (vin, issue_status)
                )
                """
            )
            db.commit()

    def get(self, vin: str, issue_status: str):
        with self.connect() as db:
            return db.execute(
                """
                SELECT *
                FROM cases
                WHERE vin = ?
                  AND issue_status = ?
                """,
                (
                    vin,
                    issue_status,
                ),
            ).fetchone()

    def save(
        self,
        vin: str,
        issue_status: str,
        workflow_status: str,
        note: str,
        tir_spz: str = "",
        uniqa_spz: str = "",
        detail: str = "",
    ):
        now = datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        )

        with self.connect() as db:

            existing = db.execute(
                """
                SELECT created_at
                FROM cases
                WHERE vin = ?
                  AND issue_status = ?
                """,
                (
                    vin,
                    issue_status,
                ),
            ).fetchone()

            created_at = (
                existing["created_at"]
                if existing
                else now
            )

            db.execute(
                """
                INSERT OR REPLACE INTO cases (
                    vin,
                    issue_status,
                    workflow_status,
                    note,
                    tir_spz,
                    uniqa_spz,
                    detail,
                    created_at,
                    updated_at
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    vin,
                    issue_status,
                    workflow_status,
                    note,
                    tir_spz,
                    uniqa_spz,
                    detail,
                    created_at,
                    now,
                ),
            )

            db.commit()

    def resolved(self):
        with self.connect() as db:
            return db.execute(
                """
                SELECT *
                FROM cases
                WHERE workflow_status = 'VYŘEŠENO'
                ORDER BY updated_at DESC
                """
            ).fetchall()

    def count_resolved(self) -> int:
        with self.connect() as db:
            row = db.execute(
                """
                SELECT COUNT(*) AS cnt
                FROM cases
                WHERE workflow_status = 'VYŘEŠENO'
                """
            ).fetchone()

            return int(
                row["cnt"]
            )


