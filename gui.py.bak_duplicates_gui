    def run_check(self):

        self.run_button.config(
            state="disabled",
            text="Probíhá kontrola...",
        )

        self.tirbazar_loaded_at = ""
        self.uniqa_loaded_at = ""

        self.uniqa_duplicates = []
        self.uniqa_raw_count = 0
        self.uniqa_unique_count = 0

        self.live_dot.config(
            fg=ORANGE_FG,
        )

        self.live_status.config(
            text="KONTROLA PROBÍHÁ",
            fg=ORANGE_FG,
        )

        self.tir_dot.config(
            fg=ORANGE_FG,
        )

        self.tir_source_status.config(
            text="Načítám databázi...",
            fg=ORANGE_FG,
        )

        self.uniqa_dot.config(
            fg=GRAY_FG,
        )

        self.uniqa_source_status.config(
            text="Čekám na TIRBazar...",
            fg=TEXT_MUTED,
        )

        self.footer_left.config(
            text="Načítám aktuální data..."
        )

        threading.Thread(
            target=self._run_check_thread,
            daemon=True,
        ).start()


    # ========================================================
    # BACKGROUND
    # ========================================================

    def _run_check_thread(self):

        try:

            config = load_config()


            # =================================================
            # TIRBAZAR
            # =================================================

            tir_vehicles, duplicates = load_tirbazar_vehicles(
                config
            )

            self.tir_vehicles = tir_vehicles

            self.active_count = sum(
                1
                for v in tir_vehicles
                if not v.datum_prodeje
            )

            self.tirbazar_loaded_at = datetime.now().strftime(
                "%d.%m.%Y %H:%M:%S"
            )

            self.after(
                0,
                self._tir_loaded,
            )


            # =================================================
            # UNIQA
            # =================================================

            self.after(
                0,
                self._uniqa_loading,
            )

            uniqa = load_uniqa_vehicles()

            self.uniqa_loaded_at = datetime.now().strftime(
                "%d.%m.%Y %H:%M:%S"
            )

            self.uniqa_duplicates = getattr(
                uniqa,
                "duplicates",
                [],
            )

            self.uniqa_raw_count = getattr(
                uniqa,
                "raw_count",
                len(uniqa.vehicles),
            )

            self.uniqa_unique_count = len(
                uniqa.vehicles
            )

            self.after(
                0,
                self._uniqa_loaded,
                uniqa,
            )


            # =================================================
            # POROVNÁNÍ
            # =================================================

            results = compare_vehicles(
                tir=tir_vehicles,
                uniqa=uniqa.vehicles,
                uniqa_available=uniqa.available,
                uniqa_error=uniqa.error,
            )


            # =================================================
            # CSV
            # =================================================

            base = prepare_output()

            try:

                write_tirbazar_snapshot(
                    tir_vehicles,
                    base,
                )

            except TypeError:

                active = [
                    v
                    for v in tir_vehicles
                    if not v.datum_prodeje
                ]

                sold = [
                    v
                    for v in tir_vehicles
                    if v.datum_prodeje
                ]

                write_tirbazar_snapshot(
                    active,
                    sold,
                    base,
                )

            write_duplicates(
                duplicates,
                base,
            )

            csv_path = write_comparison(
                results,
                base,
            )

            self.results = results
            self.last_csv = csv_path

            self.after(
                0,
                self._finish_check,
                uniqa,
            )

        except Exception as exc:

            self.after(
                0,
                self._show_error,
                str(exc),
            )


    # ========================================================
    # TIRBAZAR LOADED
    # ========================================================

    def _tir_loaded(self):

        self.tir_dot.config(
            fg=GREEN_FG,
        )

        self.tir_source_status.config(
            text=f"Načteno: {self.tirbazar_loaded_at}",
            fg=GREEN_FG,
        )

        self.tir_source_detail.config(
            text=(
                f"SQL Server / TIRBazar  •  "
                f"Aktivních ke kontrole: {self.active_count}"
            )
        )


    # ========================================================
    # UNIQA LOADING
    # ========================================================

    def _uniqa_loading(self):

        self.uniqa_dot.config(
            fg=ORANGE_FG,
        )

        self.uniqa_source_status.config(
            text="Načítám portál UNIQA...",
            fg=ORANGE_FG,
        )


    # ========================================================
    # UNIQA LOADED
    # ========================================================

    def _uniqa_loaded(self, uniqa):

        if uniqa.available:

            duplicate_groups = len(
                self.uniqa_duplicates
            )

            duplicate_extra = max(
                0,
                self.uniqa_raw_count
                - self.uniqa_unique_count,
            )

            self.uniqa_dot.config(
                fg=GREEN_FG,
            )

            self.uniqa_source_status.config(
                text=f"Načteno: {self.uniqa_loaded_at}",
                fg=GREEN_FG,
            )

            self.uniqa_source_detail.config(
                text=(
                    f"AIV UNIQA / Denní POV / Aktivní  •  "
                    f"{self.uniqa_unique_count} unikátních VIN  •  "
                    f"{self.uniqa_raw_count} pojistných záznamů  •  "
                    f"{duplicate_groups} duplicitních VIN  •  "
                    f"{duplicate_extra} záznamů navíc"
                )
            )

        else:

            self.uniqa_dot.config(
                fg=RED_FG,
            )

            self.uniqa_source_status.config(
                text=f"Chyba: {self.uniqa_loaded_at}",
                fg=RED_FG,
            )

            self.uniqa_source_detail.config(
                text="UNIQA data se nepodařilo bezpečně načíst."
            )


    # ========================================================
    # HOTOVO
    # ========================================================

    def _finish_check(self, uniqa):

        counts = Counter(
            r.status
            for r in self.results
        )

        self.cards["ACTIVE"].config(
            text=str(
                self.active_count
            )
        )

        self.cards["OK"].config(
            text=str(
                counts.get(
                    "OK",
                    0,
                )
            )
        )

        self.cards["CHYBÍ V UNIQA"].config(
            text=str(
                counts.get(
                    "CHYBÍ V UNIQA",
                    0,
                )
            )
        )

        self.cards["PRODANÉ, ALE V UNIQA"].config(
            text=str(
                counts.get(
                    "PRODANÉ, ALE V UNIQA",
                    0,
                )
            )
        )

        self.cards["SPZ NESOUHLASÍ"].config(
            text=str(
                counts.get(
                    "SPZ NESOUHLASÍ",
                    0,
                )
            )
        )

        self.cards["NAVÍC V UNIQA"].config(
            text=str(
                counts.get(
                    "NAVÍC V UNIQA",
                    0,
                )
            )
        )

        self.cards["DUPLICITNÍ V UNIQA"].config(
            text=str(
                len(
                    self.uniqa_duplicates
                )
            )
        )

        self.fill_table()

        if uniqa.available:

            self.live_dot.config(
                fg=GREEN_FG,
            )

            self.live_status.config(
                text="UNIQA LIVE ✓",
                fg=GREEN_FG,
            )

        else:

            self.live_dot.config(
                fg=RED_FG,
            )

            self.live_status.config(
                text="UNIQA NEDOSTUPNÁ",
                fg=RED_FG,
            )

        now = datetime.now().strftime(
            "%d.%m.%Y %H:%M:%S"
        )

        self.footer_left.config(
            text=f"Kontrola dokončena: {now}"
        )

        self.run_button.config(
            state="normal",
            text="▶  SPUSTIT KONTROLU",
        )


    # ========================================================
    # CHYBA
    # ========================================================

    def _show_error(self, text):

        self.run_button.config(
            state="normal",
            text="▶  SPUSTIT KONTROLU",
        )

        self.live_dot.config(
            fg=RED_FG,
        )

        self.live_status.config(
            text="CHYBA",
            fg=RED_FG,
        )

        if not self.tirbazar_loaded_at:

            self.tir_dot.config(
                fg=RED_FG,
            )

            self.tir_source_status.config(
                text="Načtení selhalo",
                fg=RED_FG,
            )

        elif not self.uniqa_loaded_at:

            self.uniqa_dot.config(
                fg=RED_FG,
            )

            self.uniqa_source_status.config(
                text="Načtení selhalo",
                fg=RED_FG,
            )

        self.footer_left.config(
            text="Kontrola skončila chybou."
        )

        messagebox.showerror(
            "UNIQA CHECKER",
            text,
        )


    # ========================================================
    # TABULKA
    # ========================================================

    def fill_table(self):

        for item in self.tree.get_children():
            self.tree.delete(item)

        search = (
            self.search_var
            .get()
            .strip()
            .upper()
        )

        selected_filter = self.filter_var.get()


        # ====================================================
        # DUPLICITY UNIQA
        # ====================================================

        if selected_filter == "DUPLICITNÍ V UNIQA":

            shown_rows = 0
            shown_vins = set()

            for group in self.uniqa_duplicates:

                if not group:
                    continue

                vin = group[0].vin

                group_searchable = " ".join(
                    [
                        v.vin or ""
                        for v in group
                    ]
                    +
                    [
                        v.spz or ""
                        for v in group
                    ]
                    +
                    [
                        v.cps or ""
                        for v in group
                    ]
                ).upper()

                if search and search not in group_searchable:
                    continue

                shown_vins.add(
                    vin
                )

                total = len(
                    group
                )

                for index, vehicle in enumerate(
                    group,
                    start=1,
                ):

                    detail = (
                        f"Záznam {index}/{total}  •  "
                        f"ČPS: {vehicle.cps or '-'}  •  "
                        f"Pojištění od: {vehicle.poj_od or '-'}"
                    )

                    if vehicle.poj_do:
                        detail += (
                            f"  •  Pojištění do: {vehicle.poj_do}"
                        )

                    self.tree.insert(
                        "",
                        "end",
                        values=(
                            "DUPLICITNÍ V UNIQA",
                            vehicle.vin,
                            "",
                            vehicle.spz or "",
                            vehicle.poj_od or "",
                            vehicle.poj_do or "",
                            detail,
                        ),
                        tags=(
                            "DUPLICITNÍ V UNIQA",
                        ),
                    )

                    shown_rows += 1

            self.footer_right.config(
                text=(
                    f"Duplicitních VIN: {len(shown_vins)}  •  "
                    f"Zobrazených pojistných záznamů: {shown_rows}"
                )
            )

            return


        # ====================================================
        # STANDARDNÍ VÝSLEDKY
        # ====================================================

        shown = 0

        for result in self.results:

            if selected_filter == "ACTIVE":

                if result.status not in (
                    "OK",
                    "CHYBÍ V UNIQA",
                    "SPZ NESOUHLASÍ",
                    "NELZE OVĚŘIT",
                ):
                    continue

            elif selected_filter != "Vše":

                if result.status != selected_filter:
                    continue

            searchable = " ".join(
                [
                    result.status or "",
                    result.vin or "",
                    result.tir_spz or "",
                    result.uniqa_spz or "",
                    result.datum_vykupu or "",
                    result.datum_prodeje or "",
                    result.detail or "",
                ]
            ).upper()

            if search and search not in searchable:
                continue

            self.tree.insert(
                "",
                "end",
                values=(
                    result.status,
                    result.vin,
                    result.tir_spz or "",
                    result.uniqa_spz or "",
                    self.format_date(
                        result.datum_vykupu
                    ),
                    self.format_date(
                        result.datum_prodeje
                    ),
                    result.detail,
                ),
                tags=(
                    result.status,
                ),
            )

            shown += 1

        filter_text = selected_filter

        if filter_text == "Vše":
            filter_text = "vše"

        elif filter_text == "ACTIVE":
            filter_text = "aktivní ke kontrole"

        self.footer_right.config(
            text=(
                f"Zobrazeno: {shown}  •  "
                f"Filtr: {filter_text}"
            )
        )


    # ========================================================
    # DATUM
    # ========================================================

    def format_date(self, value):

        if not value:
            return ""

        text = str(value).strip()

        if len(text) >= 10:

            try:

                year = text[0:4]
                month = text[5:7]
                day = text[8:10]

                return (
                    f"{day}.{month}.{year}"
                )

            except Exception:
                pass

        return text


    # ========================================================
    # DETAIL
    # ========================================================

    def open_detail(self, _event=None):

        selected = self.tree.selection()

        if not selected:
            return

        values = self.tree.item(
            selected[0]
        ).get(
            "values",
            [],
        )

        if not values:
            return

        (
            status,
            vin,
            tir_spz,
            uniqa_spz,
            datum_vykupu,
            datum_prodeje,
            detail,
        ) = values


        # ====================================================
        # DUPLICITA UNIQA
        # ====================================================

        if status == "DUPLICITNÍ V UNIQA":

            group = None

            for duplicate_group in self.uniqa_duplicates:

                if (
                    duplicate_group
                    and duplicate_group[0].vin == vin
                ):
                    group = duplicate_group
                    break

            if group:

                lines = [
                    "DUPLICITNÍ POJIŠTĚNÍ V UNIQA",
                    "",
                    f"VIN: {vin}",
                    "",
                    f"Počet aktivních pojistných záznamů: {len(group)}",
                    "",
                ]

                for index, vehicle in enumerate(
                    group,
                    start=1,
                ):

                    lines.extend(
                        [
                            f"ZÁZNAM {index}",
                            f"ČPS: {vehicle.cps or '-'}",
                            f"SPZ: {vehicle.spz or '-'}",
                            f"Pojištění od: {vehicle.poj_od or '-'}",
                            f"Pojištění do: {vehicle.poj_do or '-'}",
                            "",
                        ]
                    )

                messagebox.showwarning(
                    "Duplicitní pojištění UNIQA",
                    "\n".join(
                        lines
                    ),
                )

                return


        # ====================================================
        # BĚŽNÝ DETAIL
        # ====================================================

        messagebox.showinfo(
            "Detail vozidla",
            (
                f"STATUS\n"
                f"{status}\n\n"

                f"VIN – hlavní identifikátor\n"
                f"{vin}\n\n"

                f"SPZ TIRBazar\n"
                f"{tir_spz or 'neuvedena'}\n\n"

                f"SPZ UNIQA\n"
                f"{uniqa_spz or 'neuvedena'}\n\n"

                f"Datum výkupu / výkupu z komise\n"
                f"{datum_vykupu or 'neuvedeno'}\n\n"

                f"Datum prodeje\n"
                f"{datum_prodeje or 'neuvedeno'}\n\n"

                f"Výsledek\n"
                f"{detail}"
            ),
        )


    # ========================================================
    # CSV
    # ========================================================

    def open_csv(self):

        if not self.last_csv:

            messagebox.showinfo(
                "UNIQA CHECKER",
                "Nejdřív spusť kontrolu.",
            )

            return

        subprocess.run(
            [
                "open",
                str(self.last_csv),
            ]
        )


    # ========================================================
    # OUTPUT
    # ========================================================

    def open_output_folder(self):

        folder = (
            Path(__file__).resolve().parent
            / "output"
        )

        folder.mkdir(
            exist_ok=True,
        )

        subprocess.run(
            [
                "open",
                str(folder),
            ]
        )


