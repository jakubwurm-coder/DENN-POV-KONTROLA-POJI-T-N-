    # ========================================================
    # STYLE
    # ========================================================

    def _configure_style(self):

        style = ttk.Style(self)

        try:
            style.theme_use("clam")
        except Exception:
            pass

        style.configure(
            "App.Treeview",
            background=PANEL,
            fieldbackground=PANEL,
            foreground=TEXT,
            rowheight=38,
            borderwidth=0,
            relief="flat",
            font=("Helvetica", 10),
        )

        style.configure(
            "App.Treeview.Heading",
            background=HEADER_BG,
            foreground=TEXT,
            font=("Helvetica", 10, "bold"),
            relief="flat",
        )

        style.map(
            "App.Treeview",
            background=[
                ("selected", BORDER)
            ],
            foreground=[
                ("selected", "#ffffff")
            ],
        )

        style.map(
            "App.Treeview.Heading",
            background=[
                ("active", PANEL_2)
            ],
        )


