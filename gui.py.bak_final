class UniqaCheckerApp(tk.Tk):

    def __init__(self):
        super().__init__()

        self.title("UNIQA CHECKER")
        self.geometry("1580x930")
        self.minsize(1250, 750)
        self.configure(bg=BG)

        self.results = []
        self.tir_vehicles = []

        self.last_csv: Path | None = None

        self.active_count = 0

        self.tirbazar_loaded_at = ""
        self.uniqa_loaded_at = ""

